<?php

/**
 * @file
 * Primary module hooks for Neo | Modal module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\neo_icon\IconElement;
use Drupal\neo_modal\Modal;

/**
 * Implements hook_theme().
 */
function neo_modal_theme(): array {
  return [
    'neo_modal' => [
      'render element' => 'element',
    ],
    'neo_modal_trigger_overlay' => [
      'variables' => [
        'title' => '',
        'icon' => '',
        'attributes' => [],
      ],
    ],
    'neo_modal_account' => [
      'variables' => [
        'title' => '',
        'message' => '',
        'menu_account' => [],
        'menu_tools' => [],
        'register_title' => '',
        'register' => [],
        'user' => [],
        'form' => [],
        'primary_link' => [],
        'secondary_link' => [],
        'logout_link' => [],
      ],
    ],
  ];
}

/**
 * Implements template_preprocess().
 */
function template_preprocess_neo_modal(&$variables) {
  $variables['has_parent'] = FALSE;
  $element = $variables['element'];
  // Ensure #attributes is set.
  $element += ['#attributes' => []];

  // Special handling for form elements.
  if (isset($element['#array_parents'])) {
    // Assign an html ID.
    if (!isset($element['#attributes']['id'])) {
      $element['#attributes']['id'] = $element['#id'];
    }
    $variables['has_parent'] = TRUE;
  }

  $variables['children'] = $element['#children'];
  $variables['attributes'] = $element['#attributes'];
}

/**
 * Implements hook_module_implements_alter().
 */
function neo_modal_module_implements_alter(&$implementations, $hook) {
  if ($hook == 'library_info_alter') {
    // Move my_module_form_alter() to the end of the list.
    $group = $implementations['neo_modal'];
    unset($implementations['neo_modal']);
    $implementations['neo_modal'] = $group;
  }
}

/**
 * Implements hook_library_info_alter().
 */
function neo_modal_library_info_alter(&$libraries, $extension) {
  if ($extension == 'core') {
    $path = '/' . \Drupal::service('extension.list.module')->getPath('neo');

    $libraries['drupal.dialog']['css'] = [];
    $libraries['drupal.dialog']['js'] = [];

    // A library with no js or css will not be added to the page when
    // aggregation is enabled. So we add a js file that does nothing.
    $libraries['drupal.dialog']['js'][$path . '/js/na.js'] = ['minified' => TRUE];
    $libraries['drupal.dialog']['dependencies'][] = 'neo_modal/modal';

    $libraries['drupal.dialog.ajax']['js'] = [];
    // A library with no js or css will not be added to the page when
    // aggregation is enabled. So we add a js file that does nothing.
    $libraries['drupal.dialog.ajax']['js'][$path . '/js/na.js'] = ['minified' => TRUE];
    $libraries['drupal.dialog.ajax']['dependencies'][] = 'neo_modal/modal-dialog-ajax';
    $libraries['drupal.dialog.ajax']['dependencies'] = array_values(array_filter($libraries['drupal.dialog.ajax']['dependencies'], function ($value) {
      return $value !== 'core/jquery';
    }));
  }
  if ($extension == 'webform') {
    $path = '/' . \Drupal::service('extension.list.module')->getPath('neo_modal');
    $libraries['webform.ajax']['js'][$path . '/js/neo.webform.ajax.js'] = [];
  }
  if ($extension == 'focal_point') {
    // Focal point relies on core.dialog loading JQuery UI. But since we replace
    // it, we need to add the libraries it needs.
    $libraries['drupal.focal_point']['js']['/core/assets/vendor/jquery.ui/ui/widgets/draggable-min.js'] = [
      'weight' => '-11.6',
      'minified' => TRUE,
    ];
    $libraries['drupal.focal_point']['js']['/core/assets/vendor/jquery.ui/ui/widgets/mouse-min.js'] = [
      'weight' => '-11.7',
      'minified' => TRUE,
    ];
    // No drupal.dialog.ajax line here: inside this branch $libraries holds
    // focal_point's own libraries, so adding that key fabricated a
    // focal_point/drupal.dialog.ajax that nothing references rather than
    // touching core's. It was redundant regardless — core/drupal.dialog
    // already depends on core/internal.jquery_ui, and the core branch above
    // blanks only its js and css, leaving dependencies intact.
  }
}

/**
 * Implements hook_ajax_render_alter().
 */
function neo_modal_ajax_render_alter(array &$data) {
  foreach ($data as $delta => $command) {
    if ($command['command'] == 'ajaxRedirect') {
      if (!empty($command['data']['dialog']['neo'])) {
        $modal = new Modal(NULL, $command['data']['dialog']['neo'], $command['data']['dialog']['neo']['preset'] ?? 'dialog');
        $data[$delta]['data']['dialog']['neo'] = _neo_modal_decode_values($modal->getValues());
      }
    }
    if ($command['command'] == 'openDialog') {
      if (!empty($command['dialogOptions'])) {
        $dialogOptions = $command['dialogOptions'];
        $neo = $dialogOptions['neo'] ?? [];

        // Lowest layer: what core's jQuery-UI dialog options translate to.
        $translated = [];
        if (!empty($dialogOptions['title'])) {
          $translated['title'] = $dialogOptions['title'];
          if (empty($neo['icon'])) {
            $iconElement = new IconElement($dialogOptions['title'], NULL, NULL, ['any']);
            if ($icon = $iconElement->getIcon()) {
              $translated['icon'] = $icon->getSelector();
            }
          }
        }
        if (!empty($dialogOptions['width']) && $dialogOptions['width'] != 'auto') {
          $translated['width'] = $dialogOptions['width'];
        }
        if (!empty($dialogOptions['height']) && $dialogOptions['height'] != 'auto') {
          $translated['height'] = $dialogOptions['height'];
        }
        if (!empty($dialogOptions['position']['my'])) {
          $translated['placement'] = str_replace(' ', '-', str_replace('top', 'start', str_replace('bottom', 'end', $dialogOptions['position']['my'])));
        }

        // Middle layer: per-integration sizing, keyed by the class that asks
        // for it. Whether a dialog replaces the previous one or stacks is
        // decided client-side from the command's selector (see
        // modal-dialog-ajax.ts), matching core's same-selector-replaces
        // contract; these only carry sizing, plus the media library's `nest`.
        $overrides = [];
        if (!empty($dialogOptions['classes'])) {
          // core's `classes` is a map keyed by jQuery-UI widget part, whose
          // values are space-separated class strings — and the deprecated
          // dialogClass is appended into the same value. Matching whole values
          // therefore breaks the moment anything else adds a class: CKEditor 5
          // appends `ui-dialog--narrow` beside `media-library-widget-modal`,
          // so the media library opened from a Drupal Media button missed its
          // override entirely. Compare tokens instead.
          $tokens = array_flip(preg_split('/\s+/', trim(implode(' ', (array) $dialogOptions['classes'])), -1, PREG_SPLIT_NO_EMPTY) ?: []);
          $sizing = ['width' => '100%', 'height' => '100%'];
          $byClass = [
            // `nest` forces stacking even when the selector collides with an
            // open dialog, e.g. a media field widget inside a form that is
            // itself in a dialog.
            'media-library-widget-modal' => $sizing + ['nest' => TRUE],
            'webform-off-canvas' => $sizing,
            'webform-ui-dialog' => $sizing,
            'views-ui-dialog' => $sizing,
          ];
          foreach (array_intersect_key($byClass, $tokens) as $classOverrides) {
            $overrides += $classOverrides;
          }
          $translated['modalClasses'] = implode(' ', $dialogOptions['classes']);
        }

        // One precedence order, stated once: the caller's explicit neo options
        // beat per-integration overrides, which beat the jQuery-UI
        // translation, which beats whatever the command already carried. This
        // used to be a `+=` that put `neo` LAST, which is why `icon` needed a
        // hand-written escape hatch above while title, width, height and
        // placement had none and could never be overridden.
        $settings = $neo + $overrides + $translated + ($data[$delta]['settings'] ?? []);
        unset($settings['neo']);

        $modal = new Modal(NULL, $settings, $settings['preset'] ?? 'dialog');
        // Ship only what the Modal produced. Unioning the raw input back on
        // top re-introduced values the setters had deliberately rejected — a
        // jQuery-UI `position.my` of "center center" becomes the placement
        // "center-center", which is not a valid placement and was dropped by
        // setPlacement() and then shipped anyway.
        $data[$delta]['settings'] = _neo_modal_decode_values($modal->getValues());
      }
    }
  }
}

/**
 * Decodes Modal::getValues() for a JSON payload.
 *
 * GetValues() renders booleans as the strings 'true' and 'false', which is
 * correct for its main consumer: they are written into data-neo-modal-*
 * attributes, and the JS coerces those strings back when it reads them off a
 * trigger.
 *
 * Nothing coerces them on the AJAX path. Options handed to
 * Drupal.neoModal.open() are merged as-is, so the string 'false' arrived as a
 * truthy value and switched the option ON — `#modal => ['backdrop' => FALSE]`
 * still rendered a backdrop. It only appeared to work when the value happened
 * to match the site's global setting, because getValues() then omits the key
 * entirely and the JS default applies. Same input, opposite behaviour,
 * decided by unrelated configuration.
 *
 * @param array $values
 *   The values from Modal::getValues().
 *
 * @return array
 *   The values with attribute-encoded booleans turned back into booleans.
 */
function _neo_modal_decode_values(array $values): array {
  return array_map(function ($value) {
    if ($value === 'true') {
      return TRUE;
    }
    if ($value === 'false') {
      return FALSE;
    }
    return $value;
  }, $values);
}

/**
 * Implements hook_menu_local_actions_alter().
 */
function neo_modal_menu_local_actions_alter(&$local_actions) {
  foreach ($local_actions as $id => $action) {
    if (isset($action['modal'])) {
      $local_actions[$id]['modal'] = is_array($local_actions[$id]['modal']) ? $local_actions[$id]['modal'] : [];
      $local_actions[$id]['class'] = '\Drupal\neo_modal\Plugin\Menu\LocalAction\ModalLocalAction';
    }
  }
}

/**
 * Implements hook_element_info_alter().
 */
function neo_modal_element_info_alter(array &$info) {
  $info['submit']['#process'][] = 'neo_modal_submit_process';
}

/**
 * Process callback for submit elements that close a modal.
 */
function neo_modal_submit_process(&$element, FormStateInterface $form_state, $form) {
  if (!empty($element['#modal_close'])) {
    $element['#attributes']['data-neo-modal-close-submit'] = TRUE;
  }
  return $element;
}
